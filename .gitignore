# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
dist-ssr/
dist-electron/
*.local

# --- Copyrighted course materials (see README "Notes") ---
# Lecture slides, textbook PDFs, zyBooks exports. NEVER commit these.
pages/
sources/*
!sources/README.md
public/figures/private/
*.pdf
*.pptx
*.docx
# Lecture screenshots dropped at the repo root while authoring topics
# (set_identities.png, N-ary_relations.png, ...). Root-anchored with the
# leading slash on purpose: build/icons/*.png are real project assets and
# have to stay committed, so a bare *.png would be wrong here.
/*.png

# --- Drill data / local progress ---
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
*.sqlite
*.sqlite3
progress-export-*.json

# --- Environment / secrets ---
# Vite inlines any VITE_* var into the client bundle. Service-role keys and
# API keys must never live in a VITE_ variable.
.env
.env.*
!.env.example

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
