{
  "name": "skilltape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Self-hosted, source-grounded study app for CS coursework.",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --test \"test/**/*.test.js\"",
    "dev:server": "node server/index.js",
    "db:seed": "node server/seed.js",
    "icons": "node scripts/makeIcons.js",
    "build": "vite build",
    "preview": "vite preview",
    "audit:bank": "node scripts/auditBank.js",
    "electron:dev": "vite build && electron .",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3,bcrypt",
    "electron:clean-native": "rm -rf node_modules/bcrypt/build node_modules/better-sqlite3/build",
    "electron:build": "npm run build && npm run electron:rebuild && electron-builder --linux",
    "electron:build:win": "npm run build && npm run electron:clean-native && electron-builder --win --x64"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.19"
  },
  "allowScripts": {
    "electron@36.9.5": true
  }
}
